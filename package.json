    "@react-navigation/native-stack": "^7.2.0",
    "@supabase/supabase-js": "^2.101.1",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-glass-effect": "~0.1.9",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
